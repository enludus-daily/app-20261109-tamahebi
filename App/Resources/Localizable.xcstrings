        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝いちばんに起きて、大きな口であくび。"
          }
        }
      }
    },
    "木のかべでも跳ね返る。かべを使って回りこもう": {
      "extractionState": "manual",
      "localizations": {
